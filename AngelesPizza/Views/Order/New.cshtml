@{
    ViewData["Title"] = "Nuevo Pedido";
}

<style>
    #Quantity::-webkit-inner-spin-button,
    #Quantity::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    #Quantity {
        -moz-appearance: textfield;
    }

    .product-item {
        opacity: 0;
        animation: fadeInScale 0.6s ease-out forwards;
    }

    @@keyframes fadeInScale {
        from {
            opacity: 0;
            transform: scale(0.95);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .product-item:nth-child(1) { animation-delay: 0s; }
    .product-item:nth-child(2) { animation-delay: 0.1s; }
    .product-item:nth-child(3) { animation-delay: 0.2s; }
    .product-item:nth-child(4) { animation-delay: 0.3s; }
    .product-item:nth-child(5) { animation-delay: 0.4s; }
    .product-item:nth-child(6) { animation-delay: 0.5s; }
    .product-item:nth-child(7) { animation-delay: 0.6s; }
    .product-item:nth-child(8) { animation-delay: 0.7s; }
    .product-item:nth-child(9) { animation-delay: 0.8s; }
    .product-item:nth-child(n+10) { animation-delay: 0.9s; }

    .product-img {
        display: block;
    }
</style>

<div class="container-fluid">

    <h2 class="mb-4">
        Nuevo Pedido
    </h2>

    <div class="row">

        <!-- PANEL IZQUIERDO -->
        <div class="col-md-8">

            <div class="card shadow-sm mb-3">

                <div class="card-header">
                    <strong>Pedido</strong>
                </div>

                <div class="card-body">

                    <div class="mb-3">

                        <label class="form-label">Tipo de Pedido</label>

                        <select id="OrderType" name="OrderType" class="form-select" asp-items="ViewBag.OrderTypes">
                            <option value=""></option>
                        </select>

                    </div>

                    <div class="mb-3" id="tableContainer" style="display: none;">

                        <label class="form-label">Mesa</label>

                        <select id="RestaurantTableId"
                                class="form-select"
                                asp-items="ViewBag.Tables">

                            <option value="">Selecciona</option>

                        </select>

                    </div>

                    <div class="mb-3" id="deliveryCostContainer" style="display: none;">

                        <label class="form-label">Costo de Domicilio</label>

                        <input type="number" 
                               id="DeliveryCost" 
                               name="DeliveryCost" 
                               class="form-control" 
                               min="0"
                               step="50"
                               value="0" />

                    </div>

                    <div class="card shadow-sm mb-3">

                        <div class="card-header py-2 text-muted small fw-bold">
                            Cliente
                        </div>

                        <div class="card-body p-3">

                            <div class="mb-3">
                                <label class="form-label small mb-1">Buscar Cliente</label>
                                <select id="CustomerId" class="form-select form-select-sm" asp-items="ViewBag.Customers">
                                    <option value="">Selecciona</option>
                                </select>
                            </div>

                            <!-- Fila de Nombre y Teléfono -->
                            <div class="row g-2 mb-3">
                                <div class="col">
                                    <label class="form-label small mb-1">Nombre</label>
                                    <input id="CustomerName" class="form-control form-control-sm">
                                </div>
                                <div class="col">
                                    <label class="form-label small mb-1">Teléfono</label>
                                    <input id="CustomerPhone" class="form-control form-control-sm">
                                </div>
                            </div>

                            <!-- Fila de Dirección y Referencia -->
                            <div class="row g-2 mb-3">
                                <div class="col">
                                    <label class="form-label small mb-1">Dirección</label>
                                    <textarea id="CustomerAddress" rows="2" class="form-control form-control-sm"></textarea>
                                </div>
                                <div class="col">
                                    <label class="form-label small mb-1">Referencia</label>
                                    <textarea id="CustomerReference" rows="2" class="form-control form-control-sm"></textarea>
                                </div>
                            </div>

                            <!-- Fila de Botones -->
                            <div class="row g-2">
                                <div class="col">
                                    <button id="btnUpdateCustomer" class="btn btn-sm btn-success w-100">
                                        Guardar Cambios
                                    </button>
                                </div>
                                <div class="col">
                                    <button id="btnNewCustomer" class="btn btn-sm btn-danger w-100">
                                        Nuevo Cliente
                                    </button>
                                </div>
                            </div>

                        </div>
                    </div>

                    <hr />

                    <h5>Categorías</h5>

                    <div class="row g-2">

                        @foreach (var category in ViewBag.Categories)
                        {
                            <div class="col-md-4">

                                <button type="button" class="btn btn-secondary w-100 category-btn" data-id="@category.Id">
                                    @category.Name
                                </button>

                            </div>
                        }

                    </div>

                    <hr />

                    <h5>Productos</h5>

                    <div id="products" class="row g-2">
                    </div>

                </div>

            </div>

        </div>

        <!-- PANEL DERECHO -->
        <div class="col-md-4">

            <div class="card shadow-sm">

                <div class="card-header">
                    <strong>Pedido Actual</strong>
                </div>

                <div class="card-body">

                    <div id="orderDetails">

                        <div class="text-muted">
                            No hay productos agregados.
                        </div>

                    </div>

                    <hr />

                    <div id="orderSummary">
                        <!-- Aquí se mostrará el desglose dinámico -->
                    </div>

                    <button id="btnConfirmOrder" class="btn btn-success w-100">
                        Confirmar Pedido
                    </button>

                </div>

            </div>

        </div>

    </div>

</div>

<!-- MODAL ALERTA CAJA CERRADA -->
<div class="modal fade" id="cashRegisterAlertModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Caja Cerrada
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="cashRegisterAlertMessage">No hay ninguna caja abierta. Debe abrir la caja antes de registrar pedidos.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Entendido
                </button>
                <a asp-controller="CashRegister" asp-action="Open" class="btn btn-success">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Abrir Caja
                </a>
            </div>
        </div>
    </div>
</div>

<!-- MODAL ADICIONALES/SABORES-->
<div class="modal fade" id="productModal" tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h4 class="modal-title fw-bold" id="productName">
                    Producto
                </h4>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <input type="hidden" id="ProductId" />

                <div class="mb-3">

                    <div class="mb-4">

                        <label class="form-label fw-bold fs-5">
                            Cantidad
                        </label>

                        <div class="input-group" style="max-width: 150px;">

                            <button type="button"
                                    class="btn btn-danger"
                                    id="btnDecreaseQuantity">
                                −
                            </button>

                            <input type="number"
                                   id="Quantity"
                                   class="form-control text-center fw-bold fs-6"
                                   value="1"
                                   min="1"
                                   max="99" />

                            <button type="button"
                                    class="btn btn-danger"
                                    id="btnIncreaseQuantity">
                                +
                            </button>

                        </div>

                    </div>

                    <label class="form-label fw-bold fs-5">
                        Observaciones
                    </label>

                    <textarea id="Notes"
                              class="form-control"
                              rows="3"></textarea>

                </div>

                <hr />

                <h5><strong>Adicionales o sabores</strong></h5>

                <div id="modifierList">

                    <div class="text-muted">
                        Cargando...
                    </div>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Cancelar

                </button>

                <button type="button"
                        id="btnAddProduct"
                        class="btn btn-danger">

                    Agregar

                </button>

            </div>

        </div>

    </div>

</div>


<!-- MODAL CLIENTE -->
<div class="modal fade" id="customerModal" tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Nuevo Cliente
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <div class="mb-3">

                    <label class="form-label">
                        Nombre
                    </label>

                    <input id="NewCustomerName"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Teléfono
                    </label>

                    <input id="NewCustomerPhone"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Dirección
                    </label>

                    <textarea id="NewCustomerAddress"
                              rows="2"
                              class="form-control"></textarea>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        Referencia
                    </label>

                    <textarea id="NewCustomerReference"
                              rows="2"
                              class="form-control"></textarea>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Cancelar

                </button>

                <button type="button"
                        id="btnSaveCustomer"
                        class="btn btn-danger">

                    Guardar

                </button>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        $(function () {

            $(".category-btn").click(function () {

                let categoryId = $(this).data("id");

                $.get("/Order/GetProducts", { categoryId: categoryId }, function (products) {

                    let html = "";

                    products.forEach(function (p) {

                        let image = p.hasImage
                            ? `/Product/GetImage/${p.id}`
                            : "/images/no-image.png";

                        html += `
                            <div class="col-md-3 product-item">

                                <button class="btn btn-outline-secondary w-100 product-btn"
                                        data-id="${p.id}"
                                        data-name="${p.name}">

                                    <img src="${image}"
                                         class="img-fluid rounded mb-2 product-img"
                                         style="height:120px;object-fit:cover;" />

                                    <div><strong>${p.name}</strong></div>

                                    <small>$${p.price.toLocaleString()}</small>

                                </button>

                            </div>`;
                    });

                    $("#products").html(html);

                    preloadImages(products);

                });

            });

            function preloadImages(products) {
                products.forEach(function (p) {
                    if (p.hasImage) {
                        let img = new Image();
                        img.src = `/Product/GetImage/${p.id}`;
                    }
                });
            }

        });

        $(document).on("click", ".product-btn", function () {

            const productId = $(this).data("id");

            $("#ProductId").val(productId);

            $("#productName").text($(this).data("name"));

            $("#Quantity").val(1);

            $("#Notes").val("");

            $.get("/Order/GetModifiers",
            {
                productId: productId
            },
            function (modifiers) {

                let html = "";

                modifiers.forEach(function (m) {

                    html += `
                        <div class="form-check">

                            <input class="form-check-input modifier-check"
                                   type="checkbox"
                                   value="${m.id}"
                                   data-cost="${m.extraCost}">

                            <label class="form-check-label fs-6">

                                ${m.name}
                                ${m.extraCost > 0 ? `+$${m.extraCost.toLocaleString()}` : ''}

                            </label>

                        </div>`;
                });

                if (modifiers.length === 0) {

                    html = `
                        <div class="text-muted">
                            Este producto no tiene sabores o adicionales.
                        </div>`;
                }

                $("#modifierList").html(html);

                const modal = new bootstrap.Modal(document.getElementById("productModal"));
                modal.show();

            });

        });

        $("#btnAddProduct").click(function () {

            let modifierIds = [];

            $(".modifier-check:checked").each(function () {
                modifierIds.push($(this).val());
            });

            let quantity = parseInt($("#Quantity").val()) || 1;

            $.post("/Order/AddProduct", {

                productId: $("#ProductId").val(),
                quantity: quantity,
                notes: $("#Notes").val(),
                modifierIds: modifierIds

            }, function (response) {

                bootstrap.Modal.getInstance(
                    document.getElementById("productModal")
                ).hide();

                loadOrder();

            });

        });

        function loadOrder() {

            $.get("/Order/GetCurrentOrder", function (items) {

                let html = "";
                let total = 0;

                items.forEach(function (item, index) {

                    total += item.total;

                    html += `
                        <div class="card mb-2">

                            <div class="card-body p-2">

                                <div class="d-flex justify-content-between">

                                    <strong>${item.productName} x ${item.quantity} unds.</strong>

                                    <button class="btn btn-sm btn-outline-danger remove-item"
                                            data-index="${index}">
                                        <i class="bi bi-trash"></i>
                                    </button>

                                </div>`;

                    if (item.modifierNames.length > 0) {

                        html += `<div class="mt-2">`;

                        item.modifierNames.forEach(function (m) {

                            html += `<div class="text-primary small">
                                        + ${m}
                                     </div>`;
                        });

                        html += `</div>`;
                    }

                    if (item.notes) {

                        html += `
                            <div class="text-muted small mt-2">
                                <strong>Obs:</strong> ${item.notes}
                            </div>`;
                    }

                    html += `

                                <div class="text-end mt-2">
                                    <strong>$${item.total.toLocaleString()}</strong>
                                </div>

                            </div>

                        </div>`;
                });

                if (items.length === 0) {

                    html = `
                        <div class="text-muted">
                            No hay productos agregados.
                        </div>`;
                }

                $("#orderDetails").html(html);

                // Obtener valores del formulario
                let orderType = $("#OrderType").val();
                let deliveryCost = parseInt($("#DeliveryCost").val()) || 0;

                // Calcular totales
                let subtotal = total;
                let finalTotal = subtotal + deliveryCost;

                // Generar resumen
                let summaryHtml = `
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal</span>
                        <span>$${subtotal.toLocaleString()}</span>
                    </div>
                `;

                // OrderType.Domicilio = 2
                if (orderType === "2" && deliveryCost > 0) {
                    summaryHtml += `
                        <div class="d-flex justify-content-between mb-2">
                            <span>Domicilio</span>
                            <span class="text-primary">$${deliveryCost.toLocaleString()}</span>
                        </div>
                    `;
                }

                summaryHtml += `
                    <hr />
                    <div class="d-flex justify-content-between">
                        <h5>Total</h5>
                        <h5>$${finalTotal.toLocaleString()}</h5>
                    </div>
                `;

                $("#orderSummary").html(summaryHtml);

            });

        }

        $(document).on("click", ".remove-item", function () {

            let index = $(this).data("index");

            $.post("/Order/RemoveProduct", {

                index: index

            }, function () {

                loadOrder();

            });

        });

        $("#btnConfirmOrder").click(function () {

            let btn = $(this);

            btn.prop("disabled", true);

            $.post("/Order/Confirm", {

                orderType: $("#OrderType").val(),
                customerId: $("#CustomerId").val(),
                restaurantTableId: $("#RestaurantTableId").val(),
                deliveryCost: $("#DeliveryCost").val() || 0

            }, function (response) {

                if (response.ok) {

                    window.location.href = "/Order/ReceivePayment/" + response.orderId;

                }
                else {

                    btn.prop("disabled", false);

                    if (response.message) {
                        $("#cashRegisterAlertMessage").text(response.message);
                    }

                    const alertModal = new bootstrap.Modal(document.getElementById("cashRegisterAlertModal"));
                    alertModal.show();
                }

            });

        });

        new TomSelect("#CustomerId", {
            create: false,

            searchField: ["text"],

            sortField: {
                field: "text",
                direction: "asc"
            },

            placeholder: "Buscar cliente por nombre o teléfono...",
            allowEmptyOption: true
        });

        $("#OrderType").change(function () {

            let orderType = $(this).val();

            $("#tableContainer").hide();
            $("#deliveryCostContainer").hide();

            $("#RestaurantTableId").val("");
            $("#DeliveryCost").val(0);

            // Domicilio = 2
            if (orderType === "2") {

                $("#deliveryCostContainer").show();

            }
            // Mesa
            else if (orderType !== "") {

                $("#tableContainer").show();

            }

            loadOrder();
        });

        // Actualizar resumen cuando cambie el costo de domicilio
        $("#DeliveryCost").on("input change", function () {
            loadOrder();
        });

        $("#CustomerId").change(function () {

            let id = $(this).val();

            if (id == "")
                return;

            $.get("/Customer/GetCustomer", {

                id: id

            }, function (response) {

                if (!response.ok)
                    return;

                $("#CustomerName").val(response.customer.name);
                $("#CustomerPhone").val(response.customer.phone);
                $("#CustomerAddress").val(response.customer.address);
                $("#CustomerReference").val(response.customer.reference);

            });

        });

        $("#btnUpdateCustomer").click(function () {

            $.post("/Customer/Update", {

                Id: $("#CustomerId").val(),
                Name: $("#CustomerName").val(),
                Phone: $("#CustomerPhone").val(),
                Address: $("#CustomerAddress").val(),
                Reference: $("#CustomerReference").val()

            }, function (response) {

                if (!response.ok) {

                    alert(response.message || "No fue posible actualizar el cliente.");
                    return;

                }

                alert("Cliente actualizado.");

            });

        });

        $("#btnNewCustomer").click(function () {

            $("#NewCustomerName").val("");
            $("#NewCustomerPhone").val("");
            $("#NewCustomerAddress").val("");
            $("#NewCustomerReference").val("");

            const modal = new bootstrap.Modal(document.getElementById("customerModal"));

            modal.show();

        });

        //Modal de Customer
        $("#btnSaveCustomer").click(function () {

            $.post("/Customer/Create", {

                Name: $("#NewCustomerName").val(),
                Phone: $("#NewCustomerPhone").val(),
                Address: $("#NewCustomerAddress").val(),
                Reference: $("#NewCustomerReference").val()

            }, function (response) {

                if (!response.ok) {

                    alert(response.message || "No fue posible crear el cliente.");
                    return;

                }

                let select = document.getElementById("CustomerId");
                let tom = select.tomselect;

                tom.addOption({
                    value: response.id,
                    text: response.name
                });

                tom.setValue(response.id);

                $("#CustomerName").val($("#NewCustomerName").val());
                $("#CustomerPhone").val($("#NewCustomerPhone").val());
                $("#CustomerAddress").val($("#NewCustomerAddress").val());
                $("#CustomerReference").val($("#NewCustomerReference").val());

                bootstrap.Modal
                    .getInstance(document.getElementById("customerModal"))
                    .hide();

            });

        });

        $("#btnIncreaseQuantity").click(function () {

            let quantity = parseInt($("#Quantity").val()) || 1;

            if (quantity < 99) {
                quantity++;
                $("#Quantity").val(quantity);
            }

        });


        $("#btnDecreaseQuantity").click(function () {

            let quantity = parseInt($("#Quantity").val()) || 1;

            if (quantity > 1) {
                quantity--;
                $("#Quantity").val(quantity);
            }

        });

        $("#Quantity").on("change", function () {

            let quantity = parseInt($(this).val()) || 1;

            if (quantity < 1)
                quantity = 1;

            if (quantity > 199)
                quantity = 199;

            $(this).val(quantity);

        });

    </script>

}