@model AngelesPizza.Models.Order

@{
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <title>Comanda @Model.OrderNumber</title>

    <style>

            h2, h4, p {
                margin: 0;
                text-align: center;
            }

            hr {
                border: none;
                border-top: 1px dashed #000;
                margin: 8px 0;
            }

            table {
                width: 100%;
                border-collapse: collapse;
            }

            .right {
                text-align: right;
            }

            .center {
                text-align: center;
            }

            .small {
                font-size: 16px;
            }

            @@media print {

                html, body {
                    width: auto;
                    height: auto;
                    min-height: 0;
                    margin: 0;
                    padding: 0;
                    box-shadow: none;
                }

                @@page {
                    size: 80mm auto;
                    margin: 0;
                }
            }

            body {
                width: 80mm;
                margin: 20px auto;
                padding: 5mm;
                font-family: Arial, Helvetica, sans-serif;
                font-size: 18px;
                background: white;
                box-shadow: 0 0 10px rgba(0,0,0,.2);
            }

    </style>

</head>

<body>

    <h2>ÁNGELES PIZZA</h2>

    <h3>@ViewBag.Copy</h3>

    <hr />

    <p><strong>Pedido #@Model.OrderNumber</strong></p>

    <p>
        @TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(Model.CreatedAt, DateTimeKind.Utc),
            TimeZoneInfo.FindSystemTimeZoneById("SA Pacific Standard Time")
        ).ToString("dd/MM/yyyy HH:mm")
    </p>

    <hr />

    @if (Model.RestaurantTable != null)
    {
        <div class="section">
            <strong>Mesa:</strong> @Model.RestaurantTable.Name
        </div>
    }

    @if (Model.OrderType == AngelesPizza.Enums.OrderType.Domicilio)
    {
        <div class="section">
            <strong>TIPO: DOMICILIO</strong>
            @if (Model.DeliveryCost > 0)
            {
                <span> - Costo: @Model.DeliveryCost.ToString("N0")</span>
            }
        </div>
    }

    @if (Model.Customer != null)
    {
        <div class="section">
            <strong>Cliente:</strong> @Model.Customer.Name
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Customer.Phone))
        {
            <div class="section">
                <strong>Tel:</strong> @Model.Customer.Phone
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Customer.Address))
        {
            <div class="section">
                <strong>Dirección:</strong>

                <br />

                @Model.Customer.Address
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Customer.Reference))
        {
            <div class="section">
                <strong>Referencia:</strong>

                <br />

                @Model.Customer.Reference
            </div>
        }
    }

    <hr />

    @foreach (var item in Model.OrderDetails)
    {
        <div style="margin-bottom:12px;">

            <strong>
                @item.Product.Name x @item.Quantity unds.
            </strong>

            @foreach (var modifier in item.OrderDetailModifiers)
            {
                var modifierName = modifier.ProductModifier.Name ?? "";
                var parenthesisIndex = modifierName.IndexOf('(');

                if (parenthesisIndex >= 0)
                {
                    modifierName = modifierName.Substring(0, parenthesisIndex).Trim();
                }

                <div class="small">
                    @modifierName
                    @(modifier.ProductModifier.ExtraCost > 0
                        ? $" (+${modifier.ProductModifier.ExtraCost:N0})"
                        : "")
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(item.Notes))
            {
                <div class="small">

                    <strong>** OBS: @item.Notes **</strong>

                </div>
            }

        </div>
    }

    <!-- <p>

        *** FIN DE COMANDA ***

    </p>-->

    <hr />

    <script>

            window.onload = function () {

                window.print();

                setTimeout(function () {

                    @if ((string)ViewBag.Copy == "COCINA")
                    {
                            <text>
                                window.location.href = "/Order/PrintKitchen/@Model.Id?copy=PIZZERO";
                            </text>
                    }
                    else
                    {
                            <text>
                                window.location.href = "/OrderDashboard";
                            </text>
                    }

                }, 800);

            };

    </script>

</body>

</html>