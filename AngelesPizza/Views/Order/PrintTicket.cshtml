@model AngelesPizza.Models.Order

@{
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <title>Ticket @Model.OrderNumber</title>

    <style>

        h2, h4, p {
            margin: 0;
            text-align: center;
        }

        hr {
            border: none;
            border-top: 1px dashed #000;
            margin: 8px 0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        .right {
            text-align: right;
        }

        .center {
            text-align: center;
        }

        .small {
            font-size: 16px;
        }

            @@media print {

                html, body {
                    width: auto;
                    height: auto;
                    min-height: 0;
                    margin: 0;
                    padding: 0;
                    box-shadow: none;
                }

                @@page {
                    size: 80mm auto;
                    margin: 0;
                }
            }

            body {
                width: 80mm;
                margin: 20px auto;
                padding: 5mm;
                font-family: Arial, Helvetica, sans-serif;
                font-size: 18px;
                background: white;
                box-shadow: 0 0 10px rgba(0,0,0,.2);
            }

    </style>

</head>

<body>

    <h2>ÁNGELES PIZZA</h2>

    <p><strong>Santa Isabel</strong></p>
    <p>Carrera 27 # 2 - 76</p>

    <p><strong>NIT:</strong> 1053333706-4</p>

    <p><strong>Teléfonos</strong></p>
    <p>601 497 9794</p>
    <p>313 488 8312</p>
    <p>313 232 2767</p>

    <hr />

    <p>Pedido #@Model.OrderNumber</p>

    <p>
        @TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(Model.CreatedAt, DateTimeKind.Utc),
            TimeZoneInfo.FindSystemTimeZoneById("SA Pacific Standard Time")
        ).ToString("dd/MM/yyyy HH:mm")
    </p>

    <hr />

    @if (Model.RestaurantTable != null)
    {
        <p>Mesa: @Model.RestaurantTable.Name</p>
    }

    <hr />

    @if (Model.OrderType == AngelesPizza.Enums.OrderType.Domicilio)
    {
        <div class="section">
            <strong>TIPO: DOMICILIO</strong>
            @if (Model.DeliveryCost > 0)
            {
                <span> - Costo: @Model.DeliveryCost.ToString("N0")</span>
            }
        </div>
    }

    @if (Model.Customer != null)
    {
        <div class="section">
            <strong>Cliente:</strong> @Model.Customer.Name
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Customer.Phone))
        {
            <div class="section">
                <strong>Tel:</strong> @Model.Customer.Phone
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Customer.Address))
        {
            <div class="section">
                <strong>Dirección:</strong>

                <br />

                @Model.Customer.Address
            </div>
        }
        
        @if (!string.IsNullOrWhiteSpace(Model.Customer.Reference))
        {
            <div class="section">
                <strong>Referencia:</strong>

                <br />

                @Model.Customer.Reference
            </div>
        }
    }

    <hr />

    @foreach (var item in Model.OrderDetails)
    {
        var unitPrice = item.Price + item.OrderDetailModifiers.Sum(x => x.ExtraCost);
        var total = unitPrice * item.Quantity;

        <strong>@item.Product.Name x @item.Quantity unds.</strong>

        @foreach (var modifier in item.OrderDetailModifiers)
        {
            var modifierName = modifier.ProductModifier.Name ?? "";
            var parenthesisIndex = modifierName.IndexOf('(');

            if (parenthesisIndex >= 0)
            {
                modifierName = modifierName.Substring(0, parenthesisIndex).Trim();
            }

            <div class="small">
                @modifierName
                @(modifier.ProductModifier.ExtraCost > 0
                    ? $" (+${modifier.ProductModifier.ExtraCost:N0})"
                    : "")
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(item.Notes))
        {
            <div class="small">
                Obs: @item.Notes
            </div>
        }

        <div>
            Precio unitario:
            <span class="right">
                $@unitPrice.ToString("N0")
            </span>
        </div>

        <div>
            Total:
            <span class="right">
                $@total.ToString("N0")
            </span>
        </div>

        <br />
    }

    <hr />

    <table>

        <tr>
            <td>Subtotal</td>
            <td class="right">@Model.SubTotal.ToString("N0")</td>
        </tr>

        @if (Model.OrderType == AngelesPizza.Enums.OrderType.Domicilio && Model.DeliveryCost > 0)
        {
            <tr>
                <td>Domicilio</td>
                <td class="right">@Model.DeliveryCost.ToString("N0")</td>
            </tr>
        }

        <!--<tr>
            <td>IVA</td>
            <td class="right">@Model.Tax.ToString("N0")</td>
        </tr> -->

        <tr>
            <td><strong>Total</strong></td>
            <td class="right"><strong>@Model.Total.ToString("N0")</strong></td>
        </tr>

    </table>

    @if (Model.Payments.Any())
    {
        var payment = Model.Payments.First();

        <hr />

        <table>

            <tr>
                <td>Pago</td>
                <td class="right">@payment.PaymentType</td>
            </tr>

            <tr>
                <td>Recibido</td>
                <td class="right">@payment.ReceivedAmount.ToString("N0")</td>
            </tr>

            <tr>
                <td>Cambio</td>
                <td class="right">@payment.ChangeAmount.ToString("N0")</td>
            </tr>

        </table>
    }

    <!--<p>¡Gracias por su compra!</p>

    <hr />-->

    <script>

            window.onload = function () {

                window.print();

                setTimeout(function () {

                    window.location.href = "/Order/PrintKitchen/@Model.Id?copy=COCINA";

                }, 1000);

            };

    </script>

</body>

</html>