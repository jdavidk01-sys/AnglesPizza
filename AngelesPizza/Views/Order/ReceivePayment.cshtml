@model AngelesPizza.Models.Order

@{
    ViewData["Title"] = "Recibir Pago";
}

<div class="container-fluid">

    <div class="row">

        <!-- Pedido -->
        <div class="col-lg-8">

            <div class="card shadow-sm">

                <div class="card-header">
                    <strong>Pedido #@Model.OrderNumber</strong>
                </div>

                <div class="card-body">

                    <table class="table table-striped align-middle">

                        <thead>

                            <tr>
                                <th>Producto</th>
                                <th>Adicional/Sabor</th>
                                <th class="text-end">Valor unitario</th>
                                <th class="text-end">Total</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model.OrderDetails)
                            {
                                var unitPrice = item.Price + item.OrderDetailModifiers.Sum(x => x.ExtraCost);
                                var total = unitPrice * item.Quantity;

                                <tr>

                                    <td>
                                        @item.Product.Name
                                        <strong>x @item.Quantity unds.</strong>
                                    </td>

                                    <td>

                                        @foreach (var modifier in item.OrderDetailModifiers)
                                        {
                                            <div>
                                                @modifier.ProductModifier.Name
                                                @(modifier.ProductModifier.ExtraCost > 0
                                                    ? $" (+${modifier.ProductModifier.ExtraCost:N0})"
                                                    : "")
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(item.Notes))
                                        {
                                            <div class="text-muted">
                                                Obs: @item.Notes
                                            </div>
                                        }

                                    </td>

                                    <td class="text-end">
                                        <input type="number"
                                               class="form-control form-control-sm text-end unit-price"
                                               data-order-detail-id="@item.Id"
                                               value="@unitPrice"
                                               min="0"
                                               step="50"/>
                                    </td>

                                    <td class="text-end">
                                        <span class="item-total">
                                            @total.ToString("N0")
                                        </span>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

        <!-- Totales -->
        <div class="col-lg-4">

            <div class="card shadow-sm">

                <div class="card-header">
                    <strong>Resumen</strong>
                </div>

                <div class="card-body">

                    <div class="d-flex justify-content-between mb-2">
                        <span>SubTotal</span>
                        <strong id="orderSubtotal">@Model.SubTotal.ToString("N0")</strong>
                    </div>

                    @if (Model.OrderType == AngelesPizza.Enums.OrderType.Domicilio && Model.DeliveryCost > 0)
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <span>Domicilio</span>
                            <strong>@Model.DeliveryCost.ToString("N0")</strong>
                        </div>
                    }

                    <div class="d-flex justify-content-between mb-2">
                        <span>IVA</span>
                        <strong>@Model.Tax.ToString("N0")</strong>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between">

                        <h5>Total</h5>

                        <h5 id="orderTotal">@Model.Total.ToString("N0")</h5>

                    </div>

                    <hr />

                    <div class="mb-3">

                        <label class="form-label">
                            Método de Pago
                        </label>

                        <select id="PaymentType" class="form-select">

                            @foreach (var item in Enum.GetValues<AngelesPizza.Enums.PaymentType>())
                            {
                                <option value="@((int)item)">
                                    @item
                                </option>
                            }

                        </select>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Valor Recibido
                        </label>

                        <input id="ReceivedAmount"
                               type="number"
                               class="form-control"
                               min="@Model.Total"
                               value="@Model.Total" />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">
                            Cambio
                        </label>

                        <input id="ChangeAmount"
                               class="form-control"
                               value="0"
                               readonly />

                    </div>

                    <div class="d-grid">

                        <button id="btnPay" class="btn btn-success w-100">
                            Cobrar
                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts{

    <script>

            function calculateOrderTotal() {

            let subtotal = 0;

            $(".unit-price").each(function () {

                let price = parseFloat($(this).val()) || 0;
                let quantity = parseInt(
                    $(this).closest("tr").find("strong").text().replace(/\D/g, "")
                ) || 1;

                let total = price * quantity;

                $(this)
                    .closest("tr")
                    .find(".item-total")
                    .text(total.toLocaleString());

                subtotal += total;
            });

            let deliveryCost = @Model.DeliveryCost;
            let tax = @Model.Tax;

            let total = subtotal + deliveryCost + tax;

            $("#orderSubtotal").text(subtotal.toLocaleString());
            $("#orderTotal").text(total.toLocaleString());

            $("#ReceivedAmount")
                .attr("min", total)
                .val(total);

            calculateChange();
        }

        $(".unit-price").on("input change", function () {
            calculateOrderTotal();
        });

        function calculateChange() {
            let total = parseInt(
                $("#orderTotal").text().replace(/\D/g, "")
            ) || 0;

            let received = parseInt($("#ReceivedAmount").val()) || 0;
            let change = received - total;

            if (change < 0) change = 0;

            $("#ChangeAmount").val(change.toLocaleString());
        }

        $("#ReceivedAmount").on("keyup change", calculateChange);

        calculateChange();

        $("#btnPay").click(function () {

            let unitPrices = [];

            $(".unit-price").each(function () {

                unitPrices.push({
                    orderDetailId: $(this).data("order-detail-id"),
                    unitPrice: parseInt($(this).val()) || 0
                });

            });

            $.post("/Order/Pay", {

                orderId: @Model.Id,
                paymentType: $("#PaymentType").val(),
                receivedAmount: $("#ReceivedAmount").val(),
                unitPrices: JSON.stringify(unitPrices)

            }, function (response) {

                if (!response.ok) {

                    alert(response.message);

                    return;
                }

                window.location.href = "/Order/PrintTicket/" + response.orderId;

            });

        });

    </script>
}