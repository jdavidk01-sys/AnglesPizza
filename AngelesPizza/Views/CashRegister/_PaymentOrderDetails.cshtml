@model IEnumerable<AngelesPizza.Models.Payment>

@if (!Model.Any())
{
    <div class="text-muted p-3 text-center">
        No se registraron pagos con este método.
    </div>
}
else
{
    <div class="accordion" id="accordionPayments_@Guid.NewGuid().ToString("N")">

        @foreach (var payment in Model)
        {
            var order = payment.Order;
            var collapseId = $"collapse_payment_{payment.Id}";

            <div class="accordion-item mb-2 border rounded">

                <h2 class="accordion-header">
                    <button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId">
                        <div class="d-flex justify-content-between w-100 me-3 align-items-center">
                            <span>
                                <strong>Pedido #@(order?.OrderNumber ?? payment.OrderId)</strong>
                                <small class="text-muted ms-2">(@order?.CreatedAt.ToLocalTime().ToString("HH:mm"))</small>
                            </span>
                            <span class="badge bg-secondary">
                                Total: $@payment.Amount.ToString("N0")
                            </span>
                        </div>
                    </button>
                </h2>

                <div id="@collapseId" class="accordion-collapse collapse">
                    <div class="accordion-body p-2">

                        <table class="table table-sm table-striped mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Producto</th>
                                    <th class="text-center">Cant.</th>
                                    <th class="text-end">Precio U.</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (order != null && order.OrderDetails.Any())
                                {
                                    @foreach (var detail in order.OrderDetails)
                                    {
                                        int detailSubtotal = detail.Quantity * detail.Price;
                                        <tr>
                                            <td>@(detail.Product?.Name ?? "Producto")</td>
                                            <td class="text-center">@detail.Quantity</td>
                                            <td class="text-end">$@detail.Price.ToString("N0")</td>
                                            <td class="text-end">$@detailSubtotal.ToString("N0")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-muted text-center">Sin detalles registrados.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        @if (order != null && order.DeliveryCost > 0)
                        {
                            <div class="d-flex justify-content-between text-muted small mt-2 px-2">
                                <span>Costo Domicilio:</span>
                                <span>$@order.DeliveryCost.ToString("N0")</span>
                            </div>
                        }

                        @if (payment.PaymentType == AngelesPizza.Enums.PaymentType.Transferencia && payment.Bank != null)
                        {
                            <div class="d-flex justify-content-between align-items-center mt-3 px-2 py-2 bg-light rounded">
                                <span class="fw-bold text-primary">Banco:</span>
                                <span>@payment.Bank.Name</span>
                            </div>
                        }

                    </div>
                </div>

            </div>
        }

    </div>
}