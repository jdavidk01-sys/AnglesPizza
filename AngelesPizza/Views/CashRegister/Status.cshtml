@model AngelesPizza.Models.CashRegister

@{
    ViewData["Title"] = "Estado de Caja";
    int cashSales = ViewBag.CashSales ?? 0;
    int transferSales = ViewBag.TransferSales ?? 0;
    int cardSales = ViewBag.CardSales ?? 0;
    int cashExpected = ViewBag.CashExpected ?? 0;
}

<div class="container-fluid">

    <h2 class="mb-4">
        Cierre / Estado de Caja
    </h2>

    <div class="row">

        <!-- PANEL IZQUIERDO: RESUMEN Y DETALLE DE PEDIDOS -->
        <div class="col-md-7">

            <!-- RESUMEN GENERAL -->
            <div class="card shadow-sm mb-4">

                <div class="card-header">
                    <strong>Resumen de la Sesión Activa (Apertura: @Model.OpenedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</strong>
                </div>

                <div class="card-body">

                    <table class="table table-striped table-bordered mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Concepto</th>
                                <th class="text-end">Monto</th>
                            </tr>
                        </thead>

                        <tbody>
                            <tr>
                                <td>Base Inicial (Efectivo)</td>
                                <td class="text-end">
                                    <strong>$@Model.InitialAmount.ToString("N0")</strong>
                                </td>
                            </tr>
                            <tr>
                                <td>Ventas en Efectivo</td>
                                <td class="text-end text-success">
                                    <strong>$@cashSales.ToString("N0")</strong>
                                </td>
                            </tr>
                            <tr>
                                <td>Ventas por Transferencia</td>
                                <td class="text-end text-primary">
                                    <strong>$@transferSales.ToString("N0")</strong>
                                </td>
                            </tr>
                            <tr>
                                <td>Ventas con Tarjeta</td>
                                <td class="text-end text-warning">
                                    <strong>$@cardSales.ToString("N0")</strong>
                                </td>
                            </tr>
                            <tr class="table-secondary">
                                <td><strong>Total Efectivo Esperado en Caja</strong></td>
                                <td class="text-end">
                                    <strong>$@cashExpected.ToString("N0")</strong>
                                </td>
                            </tr>
                        </tbody>

                    </table>

                </div>

            </div>

            <!-- DETALLE DE PEDIDOS POR MÉTODO DE PAGO -->
            <div class="card shadow-sm mb-4">

                <div class="card-header">
                    <strong>Detalle de Pedidos por Método de Pago</strong>
                </div>

                <div class="card-body">

                    <ul class="nav nav-tabs mb-3" id="paymentTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active fw-bold text-success" id="cash-tab" data-bs-toggle="tab" data-bs-target="#cash-pane" type="button" role="tab">
                                Efectivo (@Model.Payments.Count(p => p.PaymentType == AngelesPizza.Enums.PaymentType.Efectivo))
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-bold text-primary" id="transfer-tab" data-bs-toggle="tab" data-bs-target="#transfer-pane" type="button" role="tab">
                                Transferencia (@Model.Payments.Count(p => p.PaymentType == AngelesPizza.Enums.PaymentType.Transferencia))
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link fw-bold text-warning" id="card-tab" data-bs-toggle="tab" data-bs-target="#card-pane" type="button" role="tab">
                                Tarjeta (@Model.Payments.Count(p => p.PaymentType == AngelesPizza.Enums.PaymentType.Tarjeta))
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content" id="paymentTabsContent">

                        <!-- TAB EFECTIVO -->
                        <div class="tab-pane fade show active" id="cash-pane" role="tabpanel">
                            @await Html.PartialAsync("_PaymentOrderDetails", Model.Payments.Where(p => p.PaymentType == AngelesPizza.Enums.PaymentType.Efectivo))
                        </div>

                        <!-- TAB TRANSFERENCIA -->
                        <div class="tab-pane fade" id="transfer-pane" role="tabpanel">
                            @await Html.PartialAsync("_PaymentOrderDetails", Model.Payments.Where(p => p.PaymentType == AngelesPizza.Enums.PaymentType.Transferencia))
                        </div>

                        <!-- TAB TARJETA -->
                        <div class="tab-pane fade" id="card-pane" role="tabpanel">
                            @await Html.PartialAsync("_PaymentOrderDetails", Model.Payments.Where(p => p.PaymentType == AngelesPizza.Enums.PaymentType.Tarjeta))
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- PANEL DERECHO: FORMULARIO DE CIERRE -->
        <div class="col-md-5">

            <div class="card shadow-sm mb-4">

                <div class="card-header">
                    <strong>Arqueo y Cierre</strong>
                </div>

                <div class="card-body">

                    <form asp-action="Close" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">

                            <label class="form-label">
                                Efectivo Físico en Caja
                            </label>

                            <input type="number" 
                                   name="finalCashReal" 
                                   id="finalCashReal" 
                                   class="form-control" 
                                   value="@cashExpected" 
                                   min="0" 
                                   step="50" 
                                   required />

                            <div class="form-text">
                                Ingrese el valor contado físicamente en el cajón de dinero.
                            </div>

                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Observaciones / Notas
                            </label>

                            <textarea name="notes" 
                                      class="form-control" 
                                      rows="3" 
                                      placeholder="Observaciones adicionales sobre el cierre..."></textarea>

                        </div>

                        <div class="d-flex justify-content-between align-items-center">

                            <a asp-action="Index" class="btn btn-secondary">
                                Ver Historial
                            </a>

                            <button type="submit" 
                                    class="btn btn-danger" 
                                    onclick="return confirm('¿Está seguro de efectuar el cierre de caja?');">
                                Efectuar Cierre de Caja
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>