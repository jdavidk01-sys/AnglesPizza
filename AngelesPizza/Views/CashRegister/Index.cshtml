@model IEnumerable<AngelesPizza.Models.CashRegister>

@{
    ViewData["Title"] = "Historial de Cajas";
    string fromDate = ViewBag.FromDate as string ?? "";
    string toDate = ViewBag.ToDate as string ?? "";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            Historial de Cajas
        </h2>

        <a asp-action="Status" class="btn btn-success">
            <i class="bi bi-box-arrow-in-right"></i>
            Ir a Caja Activa
        </a>
    </div>

    <!-- TARJETA DE FILTROS POR FECHA -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <strong>Filtro por Fechas</strong>
        </div>

        <div class="card-body">

            <form asp-action="Index" method="get" id="filterForm">

                <div class="row g-3 align-items-end">

                    <div class="col-md-3">
                        <label class="form-label">
                            Desde (Apertura)
                        </label>
                        <input type="date" 
                               class="form-control" 
                               name="fromDate" 
                               id="fromDate" 
                               value="@fromDate" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">
                            Hasta (Apertura)
                        </label>
                        <input type="date" 
                               class="form-control" 
                               name="toDate" 
                               id="toDate" 
                               value="@toDate" />
                    </div>

                    <div class="col-md-6 text-md-end">

                        <button type="submit" class="btn btn-primary me-1">
                            <i class="bi bi-funnel"></i>
                            Filtrar
                        </button>

                        <a asp-action="Index" class="btn btn-outline-secondary me-1">
                            <i class="bi bi-x-circle"></i>
                            Limpiar
                        </a>

                        <button type="button" id="btnExportExcel" class="btn btn-success">
                            <i class="bi bi-file-earmark-excel"></i>
                            Exportar a Excel
                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-circle"></i>
            No se encontraron registros de caja en el rango de fechas seleccionado.
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-header">
                <strong>Registros de Caja</strong>
            </div>

            <div class="card-body">

                <table id="tblCashRegisters" class="table table-striped table-bordered table-sm small">

                    <thead class="table-light">

                        <tr>
                            <th>Apertura</th>
                            <th>Cierre</th>
                            <th>Monto Inicial</th>
                            <th>Ventas Efec.</th>
                            <th>Ventas Transf.</th>
                            <th>Ventas Tarj.</th>
                            <th>Esperado</th>
                            <th>Real</th>
                            <th>Diferencia</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            bool isOpen = item.IsClosed == false || item.IsClosed == null;
                            int diff = item.CashDifference ?? 0;

                            <tr>
                                <td>@item.OpenedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@(item.ClosedAt.HasValue ? item.ClosedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "-")</td>
                                <td>$@item.InitialAmount.ToString("N0")</td>
                                <td>$@item.TotalCashSales.ToString("N0")</td>
                                <td>$@item.TotalTransferSales.ToString("N0")</td>
                                <td>$@item.TotalCardSales.ToString("N0")</td>
                                <td>$@item.FinalCashExpected.ToString("N0")</td>
                                <td>@(item.FinalCashReal.HasValue ? $"${item.FinalCashReal.Value.ToString("N0")}" : "-")</td>
                                <td>
                                    @if (!isOpen)
                                    {
                                        <span>$@diff.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (isOpen)
                                    {
                                        <span class="badge bg-warning">
                                            Abierta
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Cerrada
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" 
                                       asp-route-id="@item.Id" 
                                       class="btn btn-secondary btn-sm">
                                        Detalles
                                    </a>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>

@section Scripts {

    <script>

        $(document).ready(function() {

            $('#tblCashRegisters').DataTable({

                responsive: true,
                paging: true,
                ordering: true,
                searching: true,
                info: true,
                lengthChange: true,
                pageLength: 10,

                language: {

                    decimal: ",",
                    thousands: ".",

                    processing: "Procesando...",
                    search: "Buscar:",
                    lengthMenu: "Mostrar _MENU_ registros",
                    info: "Mostrando _START_ a _END_ de _TOTAL_ registros",
                    infoEmpty: "Mostrando 0 a 0 de 0 registros",
                    infoFiltered: "(filtrado de _MAX_ registros)",

                    loadingRecords: "Cargando...",
                    zeroRecords: "No se encontraron registros",
                    emptyTable: "No hay datos disponibles en la tabla",

                    paginate: {
                        first: "Primero",
                        previous: "Anterior",
                        next: "Siguiente",
                        last: "Último"
                    },

                    aria: {
                        sortAscending: ": Activar para ordenar la columna de manera ascendente",
                        sortDescending: ": Activar para ordenar la columna de manera descendente"
                    }

                }

            });

            // Redirigir a la descarga en Excel con las fechas seleccionadas
            $('#btnExportExcel').click(function () {
                let fromDate = $('#fromDate').val();
                let toDate = $('#toDate').val();

                let url = '@Url.Action("ExportExcel", "CashRegister")' + '?fromDate=' + encodeURIComponent(fromDate) + '&toDate=' + encodeURIComponent(toDate);
                window.location.href = url;
            });

        });

    </script>

}