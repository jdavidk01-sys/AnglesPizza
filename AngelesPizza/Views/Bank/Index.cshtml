@model IEnumerable<AngelesPizza.Models.Bank>?

@{
    ViewData["Title"] = "Bancos";
}

<div class="container-fluid">

    <h2 class="mb-4">
        Bancos
    </h2>

    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <strong>Búsqueda</strong>
        </div>

        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-md-6">

                        <label class="form-label">
                            Nombre del Banco
                        </label>

                        <input type="text"
                               class="form-control"
                               name="search"
                               value="@Context.Request.Query["search"]"
                               placeholder="Ingrese un criterio de búsqueda..." />

                    </div>

                    <div class="col-md-6 text-md-end">

                        <button type="submit"
                                class="btn btn-danger">
                            <i class="bi bi-search"></i>
                            Buscar
                        </button>

                        <button type="submit"
                                name="showAll"
                                value="true"
                                class="btn btn-warning">
                            <i class="bi bi-list"></i>
                            Ver Todos
                        </button>

                        <button type="button"
                                class="btn btn-success"
                                data-bs-toggle="modal"
                                data-bs-target="#ModalCreate">
                            <i class="bi bi-plus-circle"></i>
                            Nuevo Banco
                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

    @if (Model == null)
    {
        <div class="alert alert-warning">
            <i class="bi bi-info-circle"></i>
            Realice una búsqueda o presione <strong>Ver Todos</strong> para consultar los bancos.
        </div>
    }
    else if (!Model.Any())
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-circle"></i>
            No se encontraron bancos con los criterios indicados.
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-header">
                <strong>Resultados</strong>
            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table id="tblBanks"
                           class="table table-striped table-hover table-bordered align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>Nombre</th>
                                <th>Código SWIFT</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @item.Name
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.SwiftCode) ? "N/A" : item.SwiftCode)
                                    </td>

                                    <td class="text-center">

                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Inactivo
                                            </span>
                                        }

                                    </td>

                                    <td class="text-center">

                                        <button type="button"
                                                class="btn btn-secondary btn-sm"
                                                data-bs-toggle="modal"
                                                data-bs-target="#ModalEdit"
                                                data-id="@item.Id"
                                                data-name="@item.Name"
                                                data-swiftcode="@(item.SwiftCode ?? "")"
                                                data-isactive="@item.IsActive">
                                            <i class="bi bi-pencil-square"></i>
                                            Editar
                                        </button>

                                        <form method="post"
                                              asp-action="Deactivate"
                                              asp-route-id="@item.Id"
                                              style="display:inline;"
                                              onsubmit="return confirm('¿Desactivar este banco?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="btn btn-warning btn-sm"
                                                    @(item.IsActive ? "" : "disabled")>
                                                <i class="bi bi-x-circle"></i>
                                                Desactivar
                                            </button>
                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>

<!-- Modal Crear Banco -->
<div class="modal fade" id="ModalCreate" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Crear Nuevo Banco</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Create" method="post">
                <div class="modal-body">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label">Nombre del Banco</label>
                        <input type="text"
                               class="form-control"
                               name="Name"
                               placeholder="Ingrese el nombre del banco"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Código SWIFT</label>
                        <input type="text"
                               class="form-control"
                               name="SwiftCode"
                               placeholder="Ej: BCVECES" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-success">
                        Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Editar Banco -->
<div class="modal fade" id="ModalEdit" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editar Banco</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Edit" method="post">
                <div class="modal-body">
                    @Html.AntiForgeryToken()

                    <input type="hidden" id="EditId" name="id" />

                    <div class="mb-3">
                        <label class="form-label">Nombre del Banco</label>
                        <input type="text"
                               class="form-control"
                               id="EditName"
                               name="name"
                               placeholder="Ingrese el nombre del banco"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Código SWIFT</label>
                        <input type="text"
                               class="form-control"
                               id="EditSwiftCode"
                               name="swiftCode"
                               placeholder="Ej: BCVECES" />
                    </div>

                    <div class="form-check">
                        <input class="form-check-input"
                               type="checkbox"
                               id="EditIsActive"
                               name="isActive"
                               value="true" />
                        <label class="form-check-label" for="EditIsActive">
                            Activo
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-primary">
                        Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {

            if ($('#tblBanks').length) {

                $('#tblBanks').DataTable({

                    responsive: true,
                    paging: true,
                    ordering: true,
                    searching: true,
                    info: true,
                    lengthChange: true,
                    pageLength: 10,

                    language: {

                        decimal: ",",
                        thousands: ".",

                        processing: "Procesando...",
                        search: "Buscar:",
                        lengthMenu: "Mostrar _MENU_ registros",
                        info: "Mostrando _START_ a _END_ de _TOTAL_ registros",
                        infoEmpty: "Mostrando 0 a 0 de 0 registros",
                        infoFiltered: "(filtrado de _MAX_ registros)",

                        loadingRecords: "Cargando...",
                        zeroRecords: "No se encontraron registros",
                        emptyTable: "No hay datos disponibles en la tabla",

                        paginate: {
                            first: "Primero",
                            previous: "Anterior",
                            next: "Siguiente",
                            last: "Último"
                        },

                        aria: {
                            sortAscending: ": Activar para ordenar la columna de manera ascendente",
                            sortDescending: ": Activar para ordenar la columna de manera descendente"
                        }

                    }

                });

            }

            // Cargar datos en modal de edición
            $('#ModalEdit').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var id = button.data('id');
                var name = button.data('name');
                var swiftCode = button.data('swiftcode');
                var isActive = button.data('isactive');

                $('#EditId').val(id);
                $('#EditName').val(name);
                $('#EditSwiftCode').val(swiftCode);
                $('#EditIsActive').prop('checked', isActive);
            });

        });

    </script>

}
