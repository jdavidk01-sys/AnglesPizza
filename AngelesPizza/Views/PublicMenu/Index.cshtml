@model IEnumerable<AngelesPizza.Models.Category>

@{
    Layout = null;
    ViewData["Title"] = "Nuestro Menú";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ÁNGELES PIZZA</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            /* Background moved to ::before to improve compatibility en iOS */
            background: none;
            min-height: 100vh;
            min-height: 100dvh;
            padding: 20px 10px;
            position: relative;
        }

        /* Fondo + overlay en elemento fijo: funciona mejor en iOS que background-attachment:fixed */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            pointer-events: none;
            background-image: url('@Url.Content("~/images/BackgroundMenu.png")');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            /* overlay color using multiple backgrounds: image on bottom, color on top */
            background-color: rgba(0, 0, 0, 0.35);
            /* Use layering: color first then image via linear-gradient + image for better control */
            background-image: linear-gradient(rgba(0,0,0,0.35), rgba(0,0,0,0.35)), url('@Url.Content("~/images/BackgroundMenu.png")');
        }

        /* Fix iOS Safari: background-attachment: fixed no renderiza bien. Para dispositivos táctiles usamos scroll en el pseudo-elemento */
        @@supports (-webkit-touch-callout: none) {
            body::before {
                /* En iOS algunos comportamientos con fixed/background pueden fallar; usar scroll-like fallback */
                background-attachment: scroll;
                background-position: center top;
            }
        }

        .menu-container {
            max-width: 80%;
            width: 80%;
            margin: 0 auto;
            padding: 0 10px;
        }

        .header {
            text-align: center;
            color: white;
            margin-bottom: 40px;
            padding: 30px 20px;
            background: linear-gradient(135deg, rgba(220, 38, 38, 0.95) 0%, rgba(234, 88, 12, 0.95) 100%);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            box-shadow: 0 8px 32px 0 rgba(220, 38, 38, 0.5);
            border: 2px solid rgba(251, 191, 36, 0.3);
        }

        .header-logo {
            width: 120px;
            height: 120px;
            margin-bottom: 15px;
            border-radius: 50%;
            border: 4px solid #FCD34D;
            box-shadow: 0 4px 15px rgba(252, 211, 77, 0.5);
            object-fit: cover;
            background: white;
            padding: 5px;
        }

        .header h1 {
            font-size: 3rem;
            font-weight: bold;
            margin-bottom: 10px;
            text-shadow: 3px 3px 6px rgba(0, 0, 0, 0.5);
            color: #FCD34D;
        }

        .header p {
            font-size: 1.2rem;
            opacity: 0.95;
            color: #FEF3C7;
        }

        .category-section {
            background: linear-gradient(135deg, rgba(245, 245, 245, 0.95) 0%, rgba(254, 243, 199, 0.95) 100%);
            border-radius: 20px;
            margin-bottom: 20px;
            box-shadow: 0 10px 30px rgba(220, 38, 38, 0.3);
            border: 3px solid rgba(234, 88, 12, 0.3);
            overflow: hidden;
        }

        .category-header {
            padding: 20px 30px;
                border-radius: 20px;
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            transition: all 0.3s ease;
            background: linear-gradient(135deg, rgba(245, 245, 245, 0.95) 0%, rgba(254, 243, 199, 0.95) 100%);
        }

        .category-header:hover {
            background: linear-gradient(135deg, rgba(251, 191, 36, 0.3) 0%, rgba(254, 243, 199, 0.95) 100%);
        }

        .category-title {
            font-size: 1.3rem;
            font-weight: bold;
            background: linear-gradient(135deg, #DC2626 0%, #EA580C 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin: 0;
            flex: 1;
        }

        .category-toggle-icon {
            font-size: 1.5rem;
            color: #EA580C;
            transition: transform 0.3s ease;
        }

        .category-toggle-icon.rotated {
            transform: rotate(180deg);
        }

        .category-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s ease;
            padding: 0 30px;
        }

        .category-content.expanded {
            max-height: 10000px;
            padding: 20px 30px 30px 30px;
        }

        .category-hint {
            color: #000;
            font-size: 0.95rem;
            margin-bottom: 20px;
            font-style: italic;
        }

        .product-card {
            background: white;
            border-radius: 15px;
            padding: 20px;
            height: 100%;
            transition: all 0.3s ease;
            border: 2px solid transparent;
            cursor: pointer;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(220, 38, 38, 0.4);
            border-color: #DC2626;
        }

        .product-image {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 10px;
            margin-bottom: 15px;
            border: 3px solid #FCD34D;
        }

        .product-name {
            font-size: 1.1rem;
            font-weight: bold;
            color: #DC2626;
            margin-bottom: 10px;
        }

        .product-description {
            color: #666;
            font-size: 0.85rem;
            margin-bottom: 15px;
            min-height: 50px;
        }

        .product-price {
            font-size: 1.1rem;
            font-weight: bold;
            color: #EA580C;
        }

        .click-hint {
            font-size: 0.85rem;
            color: #DC2626;
            margin-top: 10px;
            font-style: italic;
        }

        /* Modal Styles */
        .modal-content {
            border-radius: 20px;
            border: 3px solid #EA580C;
        }

        .modal-header {
            background: linear-gradient(135deg, #DC2626 0%, #EA580C 100%);
            color: white;
            border-radius: 17px 17px 0 0;
            padding: 20px;
        }

        .modal-title {
            font-weight: bold;
            font-size: 1rem;
            color: #FCD34D;
        }

        .modal-body {
            background: linear-gradient(135deg, #FEF3C7 0%, #FFF 100%);
            padding: 30px;
        }

        .modal-footer {
            background: #FEF3C7;
            border-radius: 0 0 17px 17px;
        }

        .modifier-item {
            background: white;
            border: 2px solid #FCD34D;
            border-radius: 10px;
            padding: 15px;
            margin-bottom: 10px;
            transition: all 0.2s ease;
        }

        .modifier-item:hover {
            border-color: #EA580C;
            box-shadow: 0 4px 8px rgba(234, 88, 12, 0.2);
        }

        .modifier-name {
            font-weight: bold;
            color: #DC2626;
            font-size: 0.8rem;
        }

        .modifier-price {
            color: #EA580C;
            font-weight: bold;
            font-size: 1rem;
        }

        .no-products {
            text-align: center;
            padding: 40px;
            color: #DC2626;
        }

        .btn-close-custom {
            background: white;
            border-radius: 50%;
            opacity: 1;
            transition: all 0.2s ease;
        }

        .btn-close-custom:hover {
            transform: rotate(90deg);
            background: #FCD34D;
        }

        .loading-spinner {
            text-align: center;
            padding: 20px;
            color: #EA580C;
        }

        /* Tablets y pantallas medianas */
        @@media (max-width: 1024px) {
            .menu-container {
                max-width: 85%;
                width: 85%;
            }

            .header-logo {
                width: 100px;
                height: 100px;
            }
        }

        /* Móviles */
        @@media (max-width: 768px) {
            body {
                padding: 15px 5px;
            }

            .header-logo {
                width: 80px;
                height: 80px;
            }

            .menu-container {
                max-width: 95%;
                width: 95%;
                padding: 0 5px;
            }

            .header h1 {
                font-size: 2rem;
            }

            .category-section {
                background: linear-gradient(135deg, rgba(255, 255, 255, 0.75) 0%, rgba(254, 243, 199, 0.75) 100%);
                padding: 15px 8px;
                margin-bottom: 15px;
            }

            .category-header {
                padding: 12px 15px;
            }

            .category-title {
                font-size: 1.1rem;
            }

            .category-content {
                padding: 0 10px;
            }

            .category-content.expanded {
                padding: 15px 10px 20px 10px;
            }

            .row.g-4 {
                --bs-gutter-x: 0.5rem;
                --bs-gutter-y: 0.5rem;
            }

            .product-card {
                background: rgba(255, 255, 255, 0.95);
                padding: 10px;
            }

            .product-name {
                font-size: 0.9rem;
                margin-bottom: 8px;
            }

            .product-image {
                height: 120px;
                margin-bottom: 10px;
            }

            .product-description {
                font-size: 0.75rem;
                margin-bottom: 10px;
                min-height: 40px;
            }

            .product-price {
                font-size: 0.95rem;
            }

            .click-hint {
                font-size: 0.75rem;
                margin-top: 8px;
            }

            .category-hint {
                font-size: 0.85rem;
                margin-bottom: 15px;
            }

            /* Modal ajustes para móviles */
            .modal-header {
                padding: 15px;
            }

            .modal-title {
                font-size: 0.9rem;
            }

            .modal-body {
                padding: 20px 15px;
            }

            .modal-body h5 {
                font-size: 1rem;
            }

            .modal-body .d-flex {
                font-size: 0.9rem;
            }

            .modal-body .d-flex span:first-child {
                font-size: 1rem !important;
            }

            .modal-body .d-flex #modalProductPrice {
                font-size: 1.2rem !important;
            }

            .modifier-item {
                padding: 10px;
                margin-bottom: 8px;
            }

            .modifier-name {
                font-size: 0.75rem;
            }

            .modifier-price {
                font-size: 0.85rem;
            }
        }

        /* Móviles pequeños */
        @@media (max-width: 480px) {
            .menu-container {
                max-width: 98%;
                width: 98%;
                padding: 0 3px;
            }

            .header {
                padding: 20px 15px;
            }

            .header h1 {
                font-size: 1.7rem;
            }

            .header-logo {
                width: 70px;
                height: 70px;
                margin-bottom: 10px;
            }

            .category-section {
                padding: 12px 5px;
            }

            .category-header {
                padding: 10px 12px;
            }

            .category-title {
                font-size: 1rem;
            }

            .product-card {
                padding: 8px;
            }

            .product-image {
                height: 100px;
            }

            .product-name {
                font-size: 0.85rem;
            }

            .product-description {
                font-size: 0.7rem;
                min-height: 35px;
            }

            .modal-title {
                font-size: 0.85rem;
            }

            .modal-body {
                padding: 15px 10px;
            }
        }
    </style>
</head>
<body>

    <div class="menu-container">

        <!-- Header -->
        <div class="header">
            <img src="~/images/logo.png" alt="Ángeles Pizza Logo" class="header-logo" />
            <h1>
                <i class="bi bi-shop"></i> ÁNGELES PIZZA
            </h1>
            <p><i class="bi bi-book"></i> Nuestro Menú</p>
        </div>

        <!-- Categories and Products -->
        @if (Model.Any())
        {
            var categoryIndex = 0;
            foreach (var category in Model)
            {
                var isFirst = categoryIndex == 0;
                <div class="category-section">
                    <div class="category-header" onclick="toggleCategory(@categoryIndex)">
                        <h2 class="category-title">
                            <i class="bi bi-tag-fill"></i> @category.Name
                        </h2>
                        <i class="bi bi-chevron-down category-toggle-icon" id="icon-@categoryIndex"></i>
                    </div>

                    <div class="category-content @(isFirst ? "expanded" : "")" id="category-@categoryIndex">
                        <p class="category-hint">
                            <i class="bi bi-hand-index"></i> Selecciona un producto para ver sus sabores o lista de adicionales
                        </p>

                        @if (!string.IsNullOrWhiteSpace(category.Description))
                        {
                            <p class="text-muted mb-4">@category.Description</p>
                        }

                        <div class="row g-4">
                            @foreach (var product in category.Products)
                            {
                                <div class="col-6 col-md-6 col-lg-4">
                                    <div class="product-card" 
                                         data-product-id="@product.Id"
                                         data-product-name="@product.Name"
                                         data-product-price="@product.Price"
                                         data-product-description="@product.Description"
                                         onclick="showProductDetails(@product.Id)">

                                        <img src="@Url.Action("GetProductImage", "PublicMenu", new { id = product.Id })"
                                             alt="@product.Name"
                                             class="product-image" />

                                        <div class="product-name">
                                            @product.Name
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(product.Description))
                                        {
                                            <div class="product-description">
                                                @product.Description
                                            </div>
                                        }

                                        <div class="product-price">
                                            <i class="bi bi-currency-dollar"></i>@product.Price.ToString("N0")
                                        </div>

                                        <div class="click-hint">
                                            <i class="bi bi-hand-index"></i> Toca para ver adicionales
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                categoryIndex++;
            }
        }
        else
        {
            <div class="category-section">
                <div class="no-products">
                    <i class="bi bi-exclamation-circle" style="font-size: 3rem;"></i>
                    <h3>No hay productos disponibles en este momento</h3>
                    <p>Por favor, vuelve más tarde</p>
                </div>
            </div>
        }

        <!-- Footer -->
        <div class="text-center text-white mt-5 mb-3" style="text-shadow: 2px 2px 4px rgba(0,0,0,0.8);">
            <p><i class="bi bi-telephone-fill"></i> Llama para ordenar</p>
            <p>&copy; @DateTime.Now.Year - ÁNGELES PIZZA</p>
        </div>

    </div>

    <!-- Modal -->
    <div class="modal fade" id="productModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalProductName">
                        <i class="bi bi-basket"></i> Producto
                    </h5>
                    <button type="button" class="btn-close btn-close-white btn-close-custom" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="modalProductDescription" class="mb-3"></div>

                    <div class="d-flex justify-content-between align-items-center mb-4 p-3 bg-white rounded" style="border: 2px solid #EA580C;">
                        <span style="font-size: 1.2rem; font-weight: bold; color: #DC2626;">Precio Base:</span>
                        <span id="modalProductPrice" style="font-size: 1.5rem; font-weight: bold; color: #EA580C;"></span>
                    </div>

                    <h5 style="color: #DC2626; border-bottom: 2px solid #FCD34D; padding-bottom: 10px; margin-bottom: 20px;">
                        <i class="bi bi-plus-circle"></i> Adicionales / Sabores
                    </h5>

                    <div id="modifiersList">
                        <div class="loading-spinner">
                            <div class="spinner-border text-danger" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p>Cargando adicionales...</p>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle"></i> Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

    <script>
        function toggleCategory(index) {
            const content = document.getElementById(`category-${index}`);
            const icon = document.getElementById(`icon-${index}`);

            if (content.classList.contains('expanded')) {
                content.classList.remove('expanded');
                icon.classList.remove('rotated');
            } else {
                content.classList.add('expanded');
                icon.classList.add('rotated');
            }
        }

        function showProductDetails(productId) {
            // Prevenir que el click en producto cierre la categoría
            event.stopPropagation();

            // Obtener información del producto desde el elemento
            const productCard = document.querySelector(`[data-product-id="${productId}"]`);
            const productName = productCard.dataset.productName;
            const productPrice = productCard.dataset.productPrice;
            const productDescription = productCard.dataset.productDescription;

            // Actualizar modal con información del producto
            document.getElementById('modalProductName').innerHTML = `<i class="bi bi-basket"></i> ${productName}`;
            document.getElementById('modalProductPrice').innerHTML = `$${parseInt(productPrice).toLocaleString()}`;

            if (productDescription) {
                document.getElementById('modalProductDescription').innerHTML = `
                    <div class="alert alert-info" style="background: white; border: 2px solid #FCD34D; color: #666;">
                        <i class="bi bi-info-circle"></i> ${productDescription}
                    </div>`;
            } else {
                document.getElementById('modalProductDescription').innerHTML = '';
            }

            // Cargar modificadores
            loadModifiers(productId);

            // Mostrar modal
            const modal = new bootstrap.Modal(document.getElementById('productModal'));
            modal.show();
        }

        function loadModifiers(productId) {
            const modifiersContainer = document.getElementById('modifiersList');

            // Mostrar loading
            modifiersContainer.innerHTML = `
                <div class="loading-spinner">
                    <div class="spinner-border text-danger" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p>Cargando adicionales...</p>
                </div>`;

            // Hacer petición AJAX
            $.get('/PublicMenu/GetProductModifiers/' + productId, function(modifiers) {
                if (modifiers.length === 0) {
                    modifiersContainer.innerHTML = `
                        <div class="text-center text-muted p-4">
                            <i class="bi bi-info-circle" style="font-size: 2rem;"></i>
                            <p class="mt-2">Este producto no tiene adicionales disponibles</p>
                        </div>`;
                } else {
                    let html = '';
                    modifiers.forEach(function(modifier) {
                        html += `
                            <div class="modifier-item">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="modifier-name">
                                        <i class="bi bi-plus-circle-fill"></i> ${modifier.name}
                                    </span>
                                    <span class="modifier-price">
                                        ${modifier.extraCost > 0 ? '+$' + modifier.extraCost.toLocaleString() : 'Incluido'}
                                    </span>
                                </div>
                            </div>`;
                    });
                    modifiersContainer.innerHTML = html;
                }
            }).fail(function() {
                modifiersContainer.innerHTML = `
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle"></i> Error al cargar los adicionales
                    </div>`;
            });
        }
    </script>

</body>
</html>
